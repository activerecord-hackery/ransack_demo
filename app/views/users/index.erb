<% content_for :title, "Simple search - Ransack demo" %>

<div class="mb-6">
  <h1 class="text-2xl font-semibold tracking-tight">Simple search</h1>
  <p class="mt-1 text-sm text-gray-600">
    A plain <code class="rounded bg-gray-100 px-1 py-0.5 text-xs">search_form_for</code> with
    predicate-suffixed field names, such as <code class="rounded bg-gray-100 px-1 py-0.5 text-xs">first_name_or_last_name_cont</code>.
  </p>
</div>

<%= search_form_for @search, html: {class: "rounded-lg bg-white p-6 shadow-xs ring-1 ring-gray-200"} do |f| %>
  <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
    <fieldset>
      <legend class="text-sm font-semibold text-gray-900">User</legend>
      <div class="mt-3 space-y-4">
        <div>
          <%= f.label :first_name_or_last_name_cont, class: "block text-sm/6 font-medium text-gray-900" %>
          <%= f.search_field :first_name_or_last_name_cont, class: input_classes %>
        </div>
        <div>
          <%= f.label :email_cont, class: "block text-sm/6 font-medium text-gray-900" %>
          <%= f.search_field :email_cont, class: input_classes %>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend class="text-sm font-semibold text-gray-900">User's posts</legend>
      <div class="mt-3 space-y-4">
        <div>
          <%= f.label :posts_title_cont, class: "block text-sm/6 font-medium text-gray-900" %>
          <%= f.search_field :posts_title_cont, class: input_classes %>
        </div>
        <div>
          <%= f.label :other_posts_title_cont, class: "block text-sm/6 font-medium text-gray-900" %>
          <%= f.search_field :other_posts_title_cont, class: input_classes %>
        </div>
      </div>
    </fieldset>
  </div>

  <%= render "search_actions", f: f %>
<% end %>

<%= render "results" %>
