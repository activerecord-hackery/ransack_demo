<div class="flex flex-wrap items-center gap-2 rounded-md bg-white p-3 ring-1 ring-gray-200" data-fields="condition" data-object-name="<%= f.object_name %>">
  <%= f.attribute_fields do |a| %>
    <%= render "attribute_fields", f: a %>
  <% end %>

  <%# selected: is passed explicitly because ransack 5.0.1 defaults it to nil,
      which stops Rails re-selecting the submitted predicate on re-render. %>
  <%= f.predicate_select({selected: f.object.predicate_name}, class: select_classes) %>

  <%= f.value_fields do |v| %>
    <%= render "value_fields", f: v %>
  <% end %>

  <%= button_to_add_fields(f, :value) %>
  <span class="ml-auto"><%= button_to_remove_fields %></span>
</div>
